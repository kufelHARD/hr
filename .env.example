# --- Claude API (Anthropic) ---
# Klucz z https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Model i poziom wysiłku (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# Temperatura – wysyłana TYLKO gdy ustawiona. Aktualne modele (np. claude-opus-5-5)
# odrzucają ten parametr, więc dla nich zostaw puste.
ANALYSIS_TEMPERATURE=

# --- Dostęp do aplikacji ---
# Hasło wspólne dla działu HR
APP_PASSWORD=zmien-mnie
# Losowy ciąg do podpisywania sesji (np. wynik: openssl rand -hex 32)
AUTH_SECRET=

# --- Przechowywanie danych ---
# Katalog na bazę i pliki (dane osobowe!). Poza repozytorium / w .gitignore.
DATA_DIR=./storage
DATABASE_URL="file:./storage/app.db"

# --- Przetwarzanie ---
# Ile CV analizować równolegle
ANALYSIS_CONCURRENCY=2
# OCR dla skanów PDF (true/false)
OCR_ENABLED=true
# Ścieżka do LibreOffice (soffice) do konwersji .doc -> .docx. Puste = wykrywanie automatyczne.
SOFFICE_PATH=
