# --- Wdrożenie na serwerze (docker-compose.server.yml) ---
# Domena, pod którą działa ATS – rekord DNS musi wskazywać na ten serwer (porty 80 i 443 otwarte).
DOMAIN=kariera.summ-it.pl

# Opcjonalnie: panel HR tylko z adresów firmy (formularz „Aplikuj” zawsze publiczny).
# Adresy/sieci oddzielone spacjami, np.: ADMIN_ALLOWED_IPS=203.0.113.10 10.0.0.0/8
ADMIN_ALLOWED_IPS=

# Hasło do panelu ustawia się przy pierwszym uruchomieniu w przeglądarce.
# AI (opcjonalnie, analiza na żądanie): Ollama na serwerze lub Claude API.
# AI_PROVIDER=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=gemma3:4b
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
